{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "apps/backend/dist/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/frontend/dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/backend/dist/server.js"
    }
  ]
}
